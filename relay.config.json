{
  "jira": {
    "site": "https://dxbzoran-1792745597422.atlassian.net",
    "project": "SCRUM",
    "optInLabel": "factory"
  },
  "pollSeconds": 60,
  "stepTimeoutMinutes": 60,
  "reworkLimit": 3,
  "enabledSteps": [
    "1-qa-orchestrate",
    "2-qa-resume",
    "3-dev-implement",
    "4-qa-verify",
    "5-dev-rework",
    "5-stuck-rework",
    "6-merge",
    "7-promote",
    "8-qa-release"
  ],
  "agents": {
    "qa": {
      "cwd": "D:\\Projects\\testforge-mvp",
      "mcpConfig": "D:/Projects/testforge-mvp/.mcp.json",
      "settingSources": "project,local",
      "allow": [
        "PowerShell",
        "Bash",
        "mcp__atlassian",
        "mcp__playwright"
      ],
      "deny": [
        "PowerShell(git push --force:*)",
        "Bash(git push --force:*)",
        "PowerShell(git push -f:*)",
        "Bash(git push -f:*)",
        "PowerShell(gh:*)",
        "Bash(gh:*)"
      ]
    },
    "dev": {
      "cwd": "D:\\Projects\\dev-nest",
      "addDirs": [
        "D:\\Projects\\sapic-site"
      ],
      "mcpConfig": "D:/Projects/dev-nest/.mcp.json",
      "settingSources": "project,local",
      "allow": [
        "PowerShell",
        "Bash",
        "mcp__atlassian",
        "mcp__playwright"
      ],
      "deny": [
        "PowerShell(gh pr merge:*)",
        "Bash(gh pr merge:*)",
        "PowerShell(gh workflow:*)",
        "Bash(gh workflow:*)",
        "PowerShell(git push --force:*)",
        "Bash(git push --force:*)",
        "PowerShell(git push -f:*)",
        "Bash(git push -f:*)",
        "PowerShell(git push origin main:*)",
        "Bash(git push origin main:*)"
      ]
    }
  },
  "product": {
    "repo": "digitaliummcc-dotcom/sapic-site",
    "ciWorkflow": "ci.yml",
    "promoteWorkflow": "promote.yml",
    "stagingUrl": "https://staging.sapic-site.pages.dev",
    "productionUrl": "https://sapic-site.pages.dev"
  }
}
